<UserControl x:Class="LightCapture.App.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
             Foreground="#364A40" Background="White" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style TargetType="RadioButton">
      <Setter Property="Height" Value="38" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="#F7F9F8" />
      <Setter Property="BorderBrush" Value="#E1E8E4" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF6F2" /></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="#E6F5EE" /><Setter Property="Foreground" Value="#0A8955" />
          <Setter Property="BorderBrush" Value="#13A86B" /><Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#087046" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="72" /><Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" /><Setter Property="Background" Value="#F3F6F4" />
      <Setter Property="Foreground" Value="#53665D" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#087046" /></Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <StackPanel Margin="24">
    <TextBlock Text="截图快捷键" FontWeight="SemiBold" />
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <RadioButton x:Name="AltChoice" GroupName="ScreenshotHotkey" Content="Alt + A" IsChecked="True" />
      <RadioButton x:Name="ControlChoice" Grid.Column="2" GroupName="ScreenshotHotkey" Content="Ctrl + Alt + A" />
    </Grid>
    <Grid Margin="0,20,0,0">
      <TextBlock Text="离线翻译" VerticalAlignment="Center" />
      <Border x:Name="StatusBadge" Background="#E6F5EE" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
        <TextBlock x:Name="StatusText" Text="已就绪" Foreground="#0A8955" FontSize="11" />
      </Border>
    </Grid>
    <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#C05D55" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
    <Border BorderBrush="#EDF1EE" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="取消" IsCancel="True" />
        <Button x:Name="SaveButton" Content="保存" IsDefault="True" Background="#13A86B" Foreground="White" Margin="8,0,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
