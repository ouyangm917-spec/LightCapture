<Window x:Class="LightCapture.App.UI.PinnedImageWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻截 · 贴图" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Background="White">
  <Grid x:Name="Surface">
    <Image x:Name="Picture" Stretch="Uniform" />
    <Border BorderBrush="#819A91" BorderThickness="1" IsHitTestVisible="False" />
    <Button x:Name="CloseButton" Content="×" ToolTip="关闭这张贴图 (Esc)"
            HorizontalAlignment="Right" VerticalAlignment="Top" Width="26" Height="26"
            MinHeight="0" Margin="4" Padding="0" FontSize="20" Cursor="Hand"
            Foreground="#566760" Background="#F5FAF8" Visibility="Hidden">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</Window>
